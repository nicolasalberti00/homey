# build artifacts
/homey
/dist/

# coverage profile (go test -coverprofile, see cmd/coverage)
/coverage.out

# local data (SQLite database)
/data/
*.db
*.db-wal
*.db-shm

# web UI (Phase 4)
web/node_modules/
web/.svelte-kit/
web/build/

# UI build embedded in the binary (scripts/embed-ui.sh fills this tree)
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# environment files
.env

# local agent context overrides (personal, never commit)
AGENTS.override.md

# agent working state (todos, session scratch)
.pi/

# browser verification artifacts (screenshots)
.openchamber/

# macOS
.DS_Store

# dev.sh token file (development only)
*.db.token
